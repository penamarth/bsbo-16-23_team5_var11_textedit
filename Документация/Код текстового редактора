class ICompanent():
    def gettext(self):
        '''
        Метод, возвращающий текст компонента.
        Определён для каждого компонента
        '''

class WordComponent(ICompanent):
    def __init__(self, word : str):
        self.content = word
        self.color = 'black'
    
    def gettext(self):
        return self.content


class SentenceComponent(ICompanent):
    def __init__(self):
        self.content = [] 
    
    def add(self, text):
        list_word = text.split()
        for word in list_word:
            self.content.append(WordComponent(word))

    def gettext(self):
        text = [i.gettext() for i in self.content]
        return ' '.join(text)
        # return text


class ParagraphComponent(ICompanent):
    def __init__(self):
        self.content = []
    
    def add(self, text):
        text = text.replace('.', '.<sen>')
        text = text.replace('!', '!<sen>')
        text = text.replace('?', '?<sen>')
        list_sentence = text.split('<sen>')
        for sentence in list_sentence:
            if sentence != ' ':
                sentence_obj = SentenceComponent()
                sentence_obj.add(sentence)
                self.content.append(sentence_obj)
        
    def gettext(self):
        text = [i.gettext() for i in self.content]
        return ' '.join(text)
        # return text


class Document:
    def __init__(self, file_name, path):
        self.name = file_name
        self.path = path
        self.content = []
    
    def inserttext(self, text):
        parts = text.split('<p>')
        first = parts[0]
        if not self.content:
            para = ParagraphComponent()
            para.add(first)
            self.content.append(para)
        else:
            self.content[-1].add(first)

        for part in parts[1:]:
            para = ParagraphComponent()
            para.add(part)
            self.content.append(para)
        
    
    def gettext(self):
        text = [i.gettext() for i in self.content]
        return '\n'.join(text) # Возваращает текст - строку
    
    def getcomponent(self):
        return self.content # Возваращет не текст, а компоненты
    
    def viewtext(self):
        if len(self.content) > 0:
            all_paragraph = list(map(lambda x: x.gettext(), self.content))
            max_line = max(map(lambda x: len(x), all_paragraph))
            print('-' * (max_line + 4))
            for paragraph in all_paragraph:
                print(f"| {paragraph.ljust(max_line)} |", end='\n')
            print('-' * (max_line + 4))


class Editor:
    def __init__(self):
        self.document = None
    
    def newDocument(self, name, path):
        self.document = Document(name, path)
    
    def insertText(self, text):
        self.document.inserttext(text)

    def getContent(self):   
        self.document.viewtext()
        
    
